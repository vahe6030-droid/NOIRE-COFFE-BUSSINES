# Neon PostgreSQL connection string
DATABASE_URL=

# Required for stable admin/customer sessions on Vercel
NOIRE_SESSION_SECRET=replace-with-a-long-random-secret

# Admin login used when the initial store is created
NOIRE_ADMIN_USER=admin
NOIRE_ADMIN_PASSWORD=change-this-password

# Optional AI provider. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

PORT=3000

# Reservation duration in minutes; availability blocks overlapping bookings for this period
NOIRE_RESERVATION_DURATION_MINUTES=90

RESEND_API_KEY=
NOIRE_EMAIL_FROM=NOIRÉ <no-reply@example.com>

# Vercel Blob: connect a Blob store to the Vercel project (OIDC works automatically).
# For non-Vercel production, provide BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=